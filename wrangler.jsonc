{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attention-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attention_feed",
      // placeholder id — replaced by `wrangler d1 create attention_feed` output before remote deploy;
      // local dev uses miniflare's local sqlite regardless of this value
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
  // Secrets (set via `wrangler secret put`, or .dev.vars locally — never here):
  //   ADMIN_KEY — creates creator accounts via POST /api/creators
}
