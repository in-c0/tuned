{
  "name": "attention-feed",
  "version": "0.1.0",
  "private": true,
  "description": "Follow what someone is paying attention to right now. Working-title MVP.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 execute attention_feed --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute attention_feed --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "typescript": "^5.6.0",
    "vitest": "~3.2",
    "wrangler": "^4.0.0"
  }
}
